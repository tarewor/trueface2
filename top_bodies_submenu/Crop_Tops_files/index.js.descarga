/* stylelint-disable selector-max-specificity */
/* stylelint-disable selector-pseudo-class-no-unknown */
/* stylelint-disable at-rule-no-unknown */

/* stylelint-disable selector-no-qualifying-type */
:root {
  /* Scaling to allow floating labels */
  --form-field-padding-top: calc(var(--form-field-padding) * 1.5);
  --form-field-padding-bottom: calc(var(--form-field-padding) * 0.5);
  --input-label-top: 1em;
  --input-label-Y-transform: calc(var(--input-label-top) * -0.5);
  --input-label-transform: translateY(var(--input-label-Y-transform))
    scale(0.85);
  --close-button-size: 12px;

  /* Focus state fallback values for storefront */
  --forms-focus-outline-width: 2px;
  --forms-focus-outline-color: rgb(0, 91, 211);
  --forms-focus-outline-offset: 1px;
}

/* Form positioning and display */
._formLoadingState_48bzm_24 {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--container-background-color);
}

._formLoadingState_48bzm_24 svg {
  fill: var(--body-text-color);
}

._formLoadingState_48bzm_24 ~ * {
  visibility: hidden;
}

section._formHeader_48bzm_42 {
  flex: 1;
  align-items: center;
  text-align: var(--container-text-alignment);
  margin: 5px auto 25px;
}

@media screen and (min-width: 893px) {
  .isPreview.isPreview--withImage section._formHeader_48bzm_42 {
    margin: calc(5px / var(--preview-scale)) auto
      calc(25px / var(--preview-scale));
  }
}

div._formDisclaimer_48bzm_56 {
  text-align: var(--container-text-alignment);
  padding: var(--disclaimer-padding);
  /* stylelint-disable-next-line declaration-no-important */
  margin: 12px auto 0 !important;
  font: var(--forms-body-font);
  color: var(--body-text-color);
  line-height: 14px;
  font-size: 10px;
}

div._consentCheckboxContainer_48bzm_67 {
  margin-top: -8px;
  padding: 6px 0;
  input {
    margin: 2px 0;
  }
}

._consentWidthReserve_48bzm_75 {
  display: grid;
  grid-template-columns: 1em minmax(0, 1fr);
  gap: var(--p-space-200, 8px);
  height: 0;
  overflow: hidden;
  visibility: hidden;
  word-break: break-word;
}

/* stylelint-disable-next-line selector-max-type */
div._formDisclaimer_48bzm_56 p {
  margin: 0;
}

/* Style links in disclaimer */
._formDisclaimer_48bzm_56 a {
  color: var(--forms-accent-color);
}

@media screen and (min-width: 893px) {
  .isPreview.isPreview--withImage p._formDisclaimer_48bzm_56,
  .isPreview.isPreview--withImage div._formDisclaimer_48bzm_56 {
    font-size: calc(12px / var(--preview-scale));
    line-height: calc(16px / var(--preview-scale));
    margin: calc(10px / var(--preview-scale)) auto 0;
  }
  .isPreview.isPreview--withImage ._consentCheckboxContainer_48bzm_67 {
    padding-bottom: calc(6px / var(--preview-scale));
    input {
      margin: 0;
    }
  }
}

form._formFieldset_48bzm_110 {
  display: flex;
  gap: 12px;
  flex-direction: column;
  padding: 0 2px;
}

@media screen and (min-width: 893px) {
  .isPreview.isPreview--withImage form._formFieldset_48bzm_110 {
    gap: calc(10px / var(--preview-scale));
  }
}

/* Submit button */
button._formSubmitButton_48bzm_124 {
  /* Reset styles that might be added on the HTML element directly */
  all: unset;

  display: flex;
  justify-content: center;
  font: var(--forms-body-font);
  line-height: var(--forms-base-font-line-height);
  padding: var(--button-padding);

  background-color: var(--button-background-color);
  color: var(--button-text-color);

  border: none;
  box-shadow: none;
  outline: var(--button-border);
  outline-offset: 1px;
  border-radius: var(--button-border-radius);

  cursor: pointer;
}

button._formSubmitButton_48bzm_124:focus-visible,
button._formSubmitButton_48bzm_124:hover {
  border: none;
  box-shadow: none;
  filter: var(--button-background-color-hovered-modifier);
}

/* Add a proper focus indicator that meets WCAG requirements */
button._formSubmitButton_48bzm_124:focus-visible {
  outline: var(--p-border-width-050, var(--forms-focus-outline-width)) solid
    var(--p-color-border-focus, var(--forms-focus-outline-color));
  outline-offset: var(--p-space-025, var(--forms-focus-outline-offset));
}

button._formSubmitButton_48bzm_124:disabled {
  background-color: var(--button-background-color);
  cursor: not-allowed;
  pointer-events: all;
}

._formSubmitButton_48bzm_124:disabled:hover,
._formSubmitButton_48bzm_124[disabled]:hover {
  background-color: var(--button-background-color);
}

@media screen and (min-width: 893px) {
  .isPreview.isPreview--withImage button._formSubmitButton_48bzm_124 {
    padding: calc(var(--button-padding) / var(--preview-scale));
    font-size: calc(var(--forms-base-font-size) / var(--preview-scale));
    line-height: calc(20px / var(--preview-scale));
  }
}
