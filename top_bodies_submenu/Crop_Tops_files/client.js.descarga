"لا يشمل مبلغ الدفع المُقدر الضرائب والشحن. تُقدم خيارات الدفع من قِبل Affirm وتخضع للتحقق من الأهلية، وقد لا تتوفر في جميع الولايات.",ineligible:"تُقدم خيارات الدفع من قِبل Affirm وتخضع للتحقق من الأهلية، وقد لا تتوفر في جميع الولايات.",dynamic_pdp:'لا يشمل مبلغ الدفع المُقدر الضرائب والشحن. تتراوح معدلات الفائدة من 0-36% كمعدل فائدة سنوي (APR). تخضع خيارات الدفع عبر تقسيط Shop Pay للتحقق من الأهلية ويتم توفيرها من قِبل شركاء الإقراض هؤلاء: <a class="help_text__link" href="https://www.affirm.com/lenders" target="_blank" aria-describedby="shopify-payment-terms-modal-warning-text">affirm.com/lenders</a>. تعتمد الخيارات على مبلغ عملية الشراء، وقد يتطلب الأمر دفع دفعة مقدمة. قد تتوفر المزيد من الخيارات عند الموافقة. إشعارات الولايات للمستهلكين: <a class="help_text__link" href="https://www.affirm.com/licenses" target="_blank" aria-describedby="shopify-payment-terms-modal-warning-text">affirm.com/licenses</a>.'}}}})),vm=s(((e,t)=>{t.exports={shopPay:"Shop Pay",banner:{learn_more:"Научете повече",view_sample_plans:"Преглед на примерни планове",split_pay_eligible:"Платете с 4 вноски от <b>{price}</b> с {shopPayLogo}",interest_only_eligible:"Разделете покупката на месечни вноски с {shopPayLogo}",dynamic_interest_only_eligible:"От <b>{price}</b>/месец с {shopPayLogo}",pay_in_4_or_as_low_as_eligible:"4 вноски без лихва, или от <b>{price}</b> на месец с {shopPayLogo}",zero_interest_eligible:"От <b>{price}</b>/месец или 0% ГПР с {shopPayLogo}",zero_interest_eligible_zero_apr:"От <b>{price}</b>/месец, 0% ГПР с {shopPayLogo}",non_eligible_min:"Платете с 4 вноски без лихва за поръчки над <b>{minPrice}</b> с {shopPayLogo}",non_eligible_monthly_payments_min:"Разделете покупката на месечни вноски за поръчки над <b>{minPrice}</b> с {shopPayLogo}",non_eligible_max:"Разделете покупката на месечни вноски за поръчки до <b>{maxPrice}</b> с {shopPayLogo}",split_pay_eligible_2:"Платете на 2 безлихвени вноски от <b>{price}</b> с {shopPayLogo}",split_pay_eligible_30:"Платете <b>{price}</b> в р