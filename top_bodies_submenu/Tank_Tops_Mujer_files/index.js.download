._formPhoneInputField_piv1u_17[data-com-onepassword-filled='dark'] ~ label {
  color: rgba(255, 255, 255, 0.85);
}

input._formPhoneInputField_piv1u_17::placeholder {
  opacity: 0;
}

input._formPhoneInputField_piv1u_17:focus-visible {
  border: none;
  outline: none;
  box-shadow: var(--form-field-border-focused);
}

._formPhoneInputContainer_piv1u_6 output {
  grid-column: 1 / 3;
}

