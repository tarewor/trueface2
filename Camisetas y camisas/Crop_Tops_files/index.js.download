/* stylelint-disable at-rule-no-unknown */
/* stylelint-disable selector-no-qualifying-type */

._selectContainer_12thd_6 {
  min-width: 0;
}

._label_12thd_10 {
  font: var(--forms-body-font);
  -webkit-font-smoothing: antialiased;
  line-height: 20px;
  color: var(--body-text-color);
  padding-bottom: 10px;
  margin-top: 0;
}

._arrowDownIcon_12thd_19 {
  margin: auto;
  pointer-events: none;
  color: var(--form-text-color);
}

._selectToggleText_12thd_25 {
  width: calc(100% - 20px);
  height: 100%;
  display: flex;
  align-items: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

._selectToggle_12thd_25 {
  width: 100%;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
  max-height: 46px;
  padding: var(--form-field-padding);
  font: var(--forms-body-font);
  background-color: var(--form-background-color);
  color: var(--form-text-color);
  box-shadow: var(--form-field-border);
  border: none;
  outline: none;
  border-radius: var(--form-field-border-radius);
}

._selectorError_12thd_53 {
  box-shadow: 0 0 0 2px var(--form-error-color);
}

._selectToggle_12thd_25:focus-visible {
  border: none;
  outline: none;
  box-shadow: var(--form-field-border-focused);
}

._dropdownContainer_12thd_63 {
  position: absolute;
  overflow: hidden;
  box-shadow: var(--form-field-border);
  border-radius: var(--form-field-border-radius);
  outline: none;
  width: 100%;
}

._showDownwards_12thd_72 {
  z-index: 4;
  top: 100%;
  left: 0;
  margin-top: 4px;
}

._showUpwards_12thd_79 {
  z-index: 4;
  bottom: 100%;
  left: 0;
  margin-bottom: 4px;
}

._optionList_12thd_86 {
  padding: 8px 7px;
  border: none;
  list-style: none;
  overflow-y: auto;
  background-color: var(--form-background-color);
  color: var(--form-text-color);
  box-sizing: border-box;
}

@media screen and (max-width: 768px) {
  ._optionList_12thd_86 {
    max-height: 100px;
  }
}

._optionListItem_12thd_102 {
  border-radius: var(--form-field-border-radius);
  cursor: pointer;
  margin-bottom: 5px;
}

._optionListItem_12thd_102:last-child {
  margin-bottom: 0;
}

._optionListItemSelected_12thd_112 {
  box-shadow: var(--form-field-border-focused);
}

._optionListItem_12thd_102 > div {
  font-size: 14px;
  font-weight: 400;
  line-height: 19px;
  letter-spacing: 0;
  text-align: left;
  padding: 9px 12px 8px;
  border-radius: var(--form-field-border-radius);
  width: 100%;
  box-sizing: border-box;
}

._optionListItemSelected_12thd_112 > div,
._optionListItem_12thd_102 > div:focus,
._optionListItem_12thd_102:hover {
  background-color: var(--forms-accent-color-hovered-modifier);
  outline: 1px solid var(--forms-accent-color);
}

@media screen and (min-width: 893px) {
  /* stylelint-disable selector-pseudo-class-no-unknown, selector-max-specificity */
  .isPreview.isPreview--withImage button._selectToggle_12thd_25 {
    padding: calc(var(--form-field-padding) / var(--preview-scale));
    font-size: calc(var(--forms-base-font-size) / var(--preview-scale));
  }

  /* stylelint-disable selector-pseudo-class-no-unknown, selector-max-specificity */
  .isPreview.isPreview--withImage ._label_12thd_10 {
    padding-bottom: calc(10px / var(--preview-scale));
  }

  /* Fixes issue with country code dropdown cutoff with images https://github.com/Shopify/forms/issues/6483  */
  .withImage ._selectToggleText_12thd_25 {
    width: 100%;
  }

  .withImage .phone-country-selector ._arrowDownIcon_12thd_19 {
    display: none;
  }
}
