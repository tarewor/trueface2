  font-weight: 400;
  font-size: 12px;
  color: rgb(97, 97, 97);
  line-height: 20px;
  padding: 6px;
  border-radius: var(--form-field-border-radius);
}

._formFileInputNativeInput_k0hif_48 {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

._formFileInputField_k0hif_5:has(:focus-visible) {
  box-shadow: inset 0 0 0 2px var(--forms-accent-color);
}

._formFileInputButton_k0hif_37:hover {
  background-color: rgb(222, 222, 222);
  color: rgb(97, 97, 97);
}

._formFileInputFileName_k0hif_69 {
  display: flex;
  align-items: center;
  margin: 0 8px;
  font: var(--forms-body-font);
  color: var(--form-text-color);
}

._formFileInputCancelButton_k0hif_77 {
  border: none;
  background-color: transparent;
  padding: 0px;
  cursor: pointer;
  display: flex;
  height: 20px;
  pointer-events: auto;
}

._formFileInputCancelButton_k0hif_77:hover svg {
  fill: black;
}

._withError_k0hif_91 {
  border: 2px solid var(--form-error-color);
  border-radius: 8px;
}

._withDrag_k0hif_96 {
  border: 1px solid rgb(204, 204, 204);
  background-color: rgb(241, 241, 241);
}
