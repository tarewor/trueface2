:root {
  --forms-base-font-line-height: 1.1;
  --subdued-text-color: rgb(109 113 117);
}

._textBody_2aowh_10,
span._textBody_2aowh_10,
p._textBody_2aowh_10 {
  text-transform: none;

  font: var(--forms-body-font);
  -webkit-font-smoothing: antialiased;
  line-height: 20px;
  color: var(--body-text-color);
  margin: 0;

