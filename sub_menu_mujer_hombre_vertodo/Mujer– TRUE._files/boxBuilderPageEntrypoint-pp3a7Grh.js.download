  .sbb-full-page-spinner__svg {
    animation: sbb-full-page-spinner-rotate 1.16s linear infinite;
  }

  .sbb-full-page-spinner__arc {
    stroke-dasharray: 3 357;
    stroke-dashoffset: -178.5;
    animation: sbb-full-page-spinner-arc 1.16s linear infinite;
  }

  .sbb-full-page-spinner__label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes sbb-full-page-spinner-rotate {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes sbb-full-page-spinner-arc {
    0%,
    100% {
      stroke-dasharray: 3 357;
      stroke-dashoffset: -178.5;
    }

    50% {
      stroke-dasharray: 83 277;
      stroke-dashoffset: -138.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sbb-full-page-spinner__svg,
    .sbb-full-page-spinner__arc {
      animation-duration: 4.64s;
    }
