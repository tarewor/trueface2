  position: relative;
  display: inline-flex;
  gap: 8px;
  /* stylelint-disable-next-line value-no-vendor-prefix */
  width: -webkit-fill-available; /* Safari, Chrome, Edge */
  /* stylelint-disable-next-line value-no-vendor-prefix */
  width: -moz-available; /* Firefox */
