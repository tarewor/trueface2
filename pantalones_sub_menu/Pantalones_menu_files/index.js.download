._nonMultineFieldLine_exnrn_11 {
  display: grid;
  gap: 8px;
}

._fieldContainer_exnrn_16 {
  width: 5rem;
  flex-grow: 1;
}

/* fixes misalignment of address fields when an image is present
  https://github.com/Shopify/forms/issues/6604
